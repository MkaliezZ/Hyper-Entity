{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hyper-entity:0.2-draft:inspection-sample-v1",
  "$comment": "The default entry validates a single-sample extension. Reusable object definitions are available through #/$defs. Host inputs are separately supplied by the local receiver. Grant resource shape is limited to exact claim versions and fields in this profile.",
  "$ref": "#/$defs/sampleExtension",
  "$defs": {
    "entityRef": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "namespace",
        "entity_id",
        "version"
      ],
      "additionalProperties": false
    },
    "claimRef": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "namespace",
        "claim_id",
        "version"
      ],
      "additionalProperties": false
    },
    "grantRef": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "grant_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "namespace",
        "grant_id",
        "version"
      ],
      "additionalProperties": false
    },
    "assetRef": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "asset_id",
        "version"
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "registered_by": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "namespace",
        "entity_id",
        "version",
        "entity_type",
        "registered_by",
        "recorded_at"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "asset_ref": {
          "$ref": "#/$defs/assetRef"
        },
        "locator": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        "relation": {
          "enum": [
            "supports",
            "contradicts",
            "context"
          ]
        }
      },
      "required": [
        "asset_ref",
        "locator",
        "relation"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "$ref": "#/$defs/entityRef"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "scope": {
          "type": "object"
        },
        "claim_kind": {
          "enum": [
            "fact",
            "inference",
            "assumption",
            "preference",
            "recommendation"
          ]
        },
        "origin_kind": {
          "enum": [
            "self_declared",
            "third_party_record",
            "direct_observation",
            "inferred"
          ]
        },
        "asserted_by": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "namespace",
        "claim_id",
        "version",
        "subject",
        "predicate",
        "value",
        "scope",
        "claim_kind",
        "origin_kind",
        "asserted_by",
        "recorded_at",
        "evidence"
      ],
      "additionalProperties": false
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "entity"
            },
            "ref": {
              "$ref": "#/$defs/entityRef"
            },
            "asset_ref": {
              "$ref": "#/$defs/assetRef"
            }
          },
          "required": [
            "kind",
            "ref",
            "asset_ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "claim"
            },
            "ref": {
              "$ref": "#/$defs/claimRef"
            },
            "asset_ref": {
              "$ref": "#/$defs/assetRef"
            }
          },
          "required": [
            "kind",
            "ref",
            "asset_ref"
          ],
          "additionalProperties": false
        }
      ]
    },
    "grant": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "grant_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "grantee": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "items": {
            "enum": [
              "read",
              "derive",
              "write",
              "disclose",
              "act"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim_ref": {
                "$ref": "#/$defs/claimRef"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "claim_ref",
              "fields"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "not_before": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "namespace",
        "grant_id",
        "version",
        "issuer",
        "grantee",
        "actions",
        "resources",
        "purpose",
        "destination",
        "not_before",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "sampleClaim": {
      "allOf": [
        {
          "$ref": "#/$defs/claim"
        },
        {
          "properties": {
            "predicate": {
              "const": "inspection.sample.density"
            },
            "claim_kind": {
              "const": "fact"
            },
            "origin_kind": {
              "enum": [
                "direct_observation",
                "third_party_record"
              ]
            },
            "value": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "number"
                },
                "unit": {
                  "const": "g/cm³"
                }
              },
              "required": [
                "number",
                "unit"
              ],
              "additionalProperties": false
            },
            "scope": {
              "type": "object",
              "properties": {
                "method_id": {
                  "type": "string",
                  "minLength": 1
                },
                "method_version": {
                  "type": "string",
                  "minLength": 1
                },
                "temperature_c": {
                  "type": "number"
                }
              },
              "required": [
                "method_id",
                "method_version",
                "temperature_c"
              ],
              "additionalProperties": false
            },
            "evidence": {
              "items": {
                "properties": {
                  "locator": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "record_id"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      ]
    },
    "sampleEntity": {
      "allOf": [
        {
          "$ref": "#/$defs/entity"
        },
        {
          "properties": {
            "entity_type": {
              "const": "sample"
            }
          }
        }
      ]
    },
    "sampleExtension": {
      "type": "object",
      "properties": {
        "version": {
          "const": "0.2-draft"
        },
        "profile": {
          "type": "object",
          "properties": {
            "id": {
              "const": "inspection.sample.density"
            },
            "version": {
              "const": "1"
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sampleEntity"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sampleClaim"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "snapshot_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "grant_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grantRef"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "version",
        "profile",
        "entities",
        "claims",
        "snapshot_bindings",
        "grant_refs"
      ],
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "properties": {
        "principal": {
          "type": "string",
          "minLength": 1
        },
        "now": {
          "type": "string",
          "format": "date-time"
        },
        "registry_status": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "grants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "active",
                  "revoked",
                  "unknown"
                ]
              },
              "grant": {
                "$ref": "#/$defs/grant"
              }
            },
            "required": [
              "status",
              "grant"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "principal",
        "now",
        "registry_status",
        "grants"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "action": {
          "enum": [
            "read",
            "derive",
            "write",
            "disclose",
            "act"
          ]
        },
        "claim_ref": {
          "$ref": "#/$defs/claimRef"
        },
        "grant_ref": {
          "$ref": "#/$defs/grantRef"
        },
        "scope": {
          "enum": [
            "sample",
            "batch"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "action",
        "claim_ref",
        "grant_ref",
        "scope",
        "purpose",
        "destination",
        "fields"
      ],
      "additionalProperties": false
    }
  }
}
